  code_action {
    action_spec {
      create_file {
        instruction: "\'use client\';\n\nimport React, { useState, useEffect, useRef } from \'react\';\nimport {\n  defaultSiteConfig,\n  SiteConfig,\n  VEHICLE_CATEGORIES,\n  INITIAL_ZONA_ONGKIR,\n  INITIAL_INVENTARIS_MOTOR,\n  DELIVERY_TIME_SLOTS,\n  BILINGUAL_COPY,\n  VehicleCategory,\n  DeliveryZone,\n  InventoryUnitRow,\n} from \'@/config/siteConfig\';\nimport {\n  calculateRentalDays,\n  calculateLivePrice,\n  formatIdr,\n} from \'@/lib/priceCalculator\';\nimport { compressImageClientSide } from \'@/lib/imageCompression\';\nimport { BookingOrderRecord } from \'@/lib/masterDbStore\';\nimport { ScooterSilhouette } from \'@/components/ScooterSilhouette\';\nimport { UatControlConsole } from \'@/components/UatControlConsole\';\nimport {\n  ArrowUpRight,\n  ChevronLeft,\n  Menu,\n  Plus,\n  Minus,\n  Check,\n  RefreshCw,\n  Sliders,\n  Smartphone,\n  Columns3,\n  MessageCircle,\n  X,\n  Send,\n  ShieldCheck,\n  AlertTriangle,\n} from \'lucide-react\';\n\ninterface EnrichedCategory extends VehicleCategory {\n  availableUnits: number;\n  totalFleetUnits: number;\n  isAvailable: boolean;\n}\n\ninterface KycDocSlotState {\n  id: \'passport\' | \'selfie\' | \'flight\' | \'hotel\';\n  status: \'blurry\' | \'compressing\' | \'verified\' | \'ready_to_upload\';\n  fileName: string;\n  compressedKb: number;\n  originalKb?: number;\n  ocrName?: string;\n  ocrNumber?: string;\n  ocrMessage: string;\n}\n\nexport function BookingWizardApp() {\n  const [lang, setLang] = useState<\'en\' | \'id\'>(\'en\');\n  const t = BILINGUAL_COPY[lang];\n\n  // Site Config (Tahap 4 Master Template)\n  const [siteConfig, setSiteConfig] = useState<SiteConfig>(defaultSiteConfig);\n\n  // Layout mode on Desktop: \'board\' (all 3 screens side-by-side like SVG) or \'single\' (focused step)\n  const [viewMode, setViewMode] = useState<\'board\' | \'single\'>(\'board\');\n  const [activeStep, setActiveStep] = useState<1 | 2 | 3>(1);\n\n  // Step 1 State: Dates, Catalog, Zone, Hotel\n  const [startDate, setStartDate] = useState<string>(\'2026-05-15\');\n  const [endDate, setEndDate] = useState<string>(\'2026-05-22\');\n  const [selectedCategoryId, setSelectedCategoryId] = useState<\n    \'nmax\' | \'pcx\' | \'scoopy\' | \'vario\' | \'fazzio\'\n  >(\'nmax\');\n  const [catalogFilter, setCatalogFilter] = useState<\'all\' | \'available\'>(\'all\');\n  const [selectedZoneId, setSelectedZoneId] = useState<string>(\'zona-2\');\n  const [hotelAndRoom, setHotelAndRoom] = useState<string>(\n    \'The Haven Suites Canggu \342\200\224 Room 204\'\n  );\n  const [deliveryTime, setDeliveryTime] = useState<string>(\n    DELIVERY_TIME_SLOTS[1].value\n  );\n  const [faqOpen, setFaqOpen] = useState<boolean>(false);\n\n  // Live Inventory from n8n Webhook 1\n  const [categories, setCategories] = useState<EnrichedCategory[]>(() =>\n    VEHICLE_CATEGORIES.map((cat) => {\n      const readyCount = INITIAL_INVENTARIS_MOTOR.filter(\n        (u) => u.categoryId === cat.id && u.status === \'READY\'\n      ).length;\n      const totalCount = INITIAL_INVENTARIS_MOTOR.filter(\n        (u) => u.categoryId === cat.id\n      ).length;\n      return {\n        ...cat,\n        availableUnits: readyCount,\n        totalFleetUnits: totalCount,\n        isAvailable: readyCount > 0,\n      };\n    })\n  );\n  const [zones, setZones] = useState<DeliveryZone[]>(INITIAL_ZONA_ONGKIR);\n  const [inventarisMotor, setInventarisMotor] = useState<InventoryUnitRow[]>(\n    INITIAL_INVENTARIS_MOTOR\n  );\n  const [orders, setOrders] = useState<BookingOrderRecord[]>([]);\n  const [isSyncingStock, setIsSyncingStock] = useState<boolean>(false);\n  const [lastSyncLatencyMs, setLastSyncLatencyMs] = useState<number>(42);\n\n  // Step 2 State: Renter Contact & 4 KYC Documents\n  const [fullName, setFullName] = useState<string>(\'Alexander Wright\');\n  const [countryCode, setCountryCode] = useState<string>(\'+61\');\n  const [whatsappLocal, setWhatsappLocal] = useState<string>(\'412 345 678\');\n  const [nationality, setNationality] = useState<string>(\n    \'Australia (Verified Foreign Tourist)\'\n  );\n  const [pdpAgreed, setPdpAgreed] = useState<boolean>(true);\n\n  const [kycDocs, setKycDocs] = useState<Record<string, KycDocSlotState>>({\n    passport: {\n      id: \'passport\',\n      status: \'blurry\',\n      fileName: \'passport_scan_glare.jpg\',\n      compressedKb: 340,\n      ocrMessage:\n        \'Text unreadable due to glare/blur. Please retake photo clearly without flash.\',\n    },\n    selfie: {\n      id: \'selfie\',\n      status: \'compressing\',\n      fileName: \'selfie_passport.jpg\',\n      compressedKb: 380,\n      originalKb: 6420,\n      ocrMessage: \'Compressing and Scanning...\',\n    },\n    flight: {\n      id: \'flight\',\n      status: \'verified\',\n      fileName: \'qf44_bali_sydney.png\',\n      compressedKb: 290,\n      ocrMessage: \'Clear\',\n    },\n    hotel: {\n      id: \'hotel\',\n      status: \'ready_to_upload\',\n      fileName: \'Upload Agoda / Booking.com / Airbnb PDF or image\',\n      compressedKb: 0,\n      ocrMessage: \'Upload Agoda / Booking.com / Airbnb PDF or image\',\n    },\n  });\n\n  // Hidden file input refs for real browser upload + compression\n  const fileInputRefs = {\n    passport: useRef<HTMLInputElement | null>(null),\n    selfie: useRef<HTMLInputElement | null>(null),\n    flight: useRef<HTMLInputElement | null>(null),\n    hotel: useRef<HTMLInputElement | null>(null),\n  };\n\n  // Step 3 State: Payment Method & Booking Submission\n  const [paymentMethod, setPaymentMethod] = useState<\n    \'instant_online\' | \'manual_transfer\' | \'cod_arrival\'\n  >(\'instant_online\');\n  const [isSubmittingBooking, setIsSubmittingBooking] = useState<boolean>(false);\n  const [bookingFeedbackError, setBookingFeedbackError] = useState<string | null>(\n    null\n  );\n  const [activeOrder, setActiveOrder] = useState<BookingOrderRecord>({\n    orderId: \'ORD-2026-881\',\n    createdAt: \'2026-05-15T09:42:00+08:00\',\n    fullName: \'Alexander Wright\',\n    whatsappNumber: \'+61 412 345 678\',\n    nationality: \'Australia (Verified Foreign Tourist)\',\n    categoryId: \'nmax\',\n    categoryName: \'Yamaha NMAX 155\',\n    startDate: \'2026-05-15\',\n    endDate: \'2026-05-22\',\n    durationDays: 7,\n    zoneId: \'zona-2\',\n    zoneLabel: \'Zona 2: Canggu / Jimbaran\',\n    hotelAndRoom: \'The Haven Suites Canggu \342\200\224 Room 204\',\n    deliveryTime: \'10:00 AM WITA (Morning Delivery)\',\n    rentalSubtotal: 950000,\n    deliveryFee: 50000,\n    totalAmount: 1000000,\n    paymentMethod: \'cod_arrival\',\n    status: \'pending_approval\',\n    ocrExtractedName: \'ALEXANDER WRIGHT\',\n    ocrExtractedIdNumber: \'PA8934120\',\n    ocrStatus: \'JELAS\',\n    whatsappMessagePreview:\n      \'Halo Alexander Wright, pesanan sewa Yamaha NMAX 155 Anda dengan ID #ORD-2026-881 telah kami terima...\',\n  });\n\n  // Modals / Drawers\n  const [isUatConsoleOpen, setIsUatConsoleOpen] = useState<boolean>(false);\n  const [isWaModalOpen, setIsWaModalOpen] = useState<boolean>(false);\n  const [waChatInput, setWaChatInput] = useState<string>(\'\');\n  const [waMessages, setWaMessages] = useState<\n    Array<{ sender: \'bot\' | \'user\'; text: string; time: string }>\n  >([\n    {\n      sender: \'bot\',\n      text: \'Om Swastiastu! Welcome to VIYOND AI Concierge & Live Order Tracker. How can I help with your Bali scooter rental today?\',\n      time: \'09:41\',\n    },\n    {\n      sender: \'bot\',\n      text: \'Halo Alexander Wright, pesanan sewa Yamaha NMAX 155 Anda dengan ID #ORD-2026-881 telah kami terima. Kurir siap mengantar ke The Haven Suites Canggu \342\200\224 Room 204 pukul 10:00 AM WITA.\',\n      time: \'09:42\',\n    },\n  ]);\n\n  // Fetch live inventory on load\n  const fetchLiveInventory = async () => {\n    setIsSyncingStock(true);\n    try {\n      const res = await fetch(\'/api/n8n/viyond-live-inventory\');\n      const data = await res.json();\n      if (data.categories) setCategories(data.categories);\n      if (data.zones) setZones(data.zones);\n      if (data.latencyMs) setLastSyncLatencyMs(data.latencyMs);\n      if (data.internalSheetPreview?.inventarisMotor) {\n        setInventarisMotor(data.internalSheetPreview.inventarisMotor);\n      }\n      if (data.internalSheetPreview?.orders?.length) {\n        setOrders(data.internalSheetPreview.orders);\n        setActiveOrder(data.internalSheetPreview.orders[0]);\n      }\n    } catch {\n      // Keep local fallback\n    } finally {\n      setTimeout(() => setIsSyncingStock(false), 250);\n    }\n  };\n\n  useEffect(() => {\n    fetchLiveInventory();\n  }, []);\n\n  // Derived price calculation\n  const selectedCategory =\n    categories.find((c) => c.id === selectedCategoryId) || categories[0];\n  const selectedZone =\n    zones.find((z) => z.id === selectedZoneId) || zones[1] || INITIAL_ZONA_ONGKIR[1];\n  const rentalDays = calculateRentalDays(startDate, endDate);\n  const priceBreakdown = calculateLivePrice(\n    selectedCategory,\n    rentalDays,\n    selectedZone,\n    siteConfig.usdExchangeRate\n  );\n\n  const formatDisplayDate = (isoDate: string) => {\n    const d = new Date(`${isoDate}T00:00:00`);\n    if (Number.isNaN(d.getTime())) return isoDate;\n    return d.toLocaleDateString(\'en-GB\', {\n      day: \'2-digit\',\n      month: \'short\',\n      year: \'numeric\',\n    });\n  };\n\n  // Handle real file upload + client-side compression + AI Vision OCR\n  const handleFileUpload = async (\n    slotId: \'passport\' | \'selfie\' | \'flight\' | \'hotel\',\n    file: File\n  ) => {\n    setKycDocs((prev) => ({\n      ...prev,\n      [slotId]: {\n        ...prev[slotId],\n        status: \'compressing\',\n        fileName: file.name,\n        ocrMessage: \'Compressing in browser (<500KB) & running AI Vision OCR...\',\n      },\n    }));\n\n    try {\n      const compressed = await compressImageClientSide(file);\n      if (slotId === \'passport\') {\n        const ocrRes = await fetch(\'/api/verify-kyc\', {\n          method: \'POST\',\n          headers: { \'Content-Type\': \'application/json\' },\n          body: JSON.stringify({\n            imageBase64: compressed.base64DataUrl,\n            mimeType: compressed.mimeType,\n            documentType: \'Passport / ID Card (KTP)\',\n          }),\n        });\n        const ocrData = await ocrRes.json();\n        const isClear = ocrData.isClear !== false;\n\n        setKycDocs((prev) => ({\n          ...prev,\n          passport: {\n            id: \'passport\',\n            status: isClear ? \'verified\' : \'blurry\',\n            fileName: compressed.fileName,\n            compressedKb: compressed.compressedSizeKb,\n            originalKb: compressed.originalSizeKb,\n            ocrName: ocrData.nama_lengkap || fullName.toUpperCase(),\n            ocrNumber: ocrData.nomor_identitas || \'PA8934120\',\n            ocrMessage: isClear\n              ? `AI OCR: JELAS (${ocrData.nomor_identitas || \'PA8934120\'}) \342\200\224 ${\n                  ocrData.reason || \'Clear\'\n                }`\n              : ocrData.reason ||\n                \'Text unreadable due to glare/blur. Please retake photo clearly without flash.\',\n          },\n        }));\n        if (isClear) setBookingFeedbackError(null);\n      } else {\n        setKycDocs((prev) => ({\n          ...prev,\n          [slotId]: {\n            id: slotId,\n            status: \'verified\',\n            fileName: compressed.fileName,\n            compressedKb: compressed.compressedSizeKb,\n            originalKb: compressed.originalSizeKb,\n            ocrMessage: `Compressed: ${compressed.compressedSizeKb} KB \342\200\224 Clear`,\n          },\n        }));\n      }\n    } catch {\n      setKycDocs((prev) => ({\n        ...prev,\n        [slotId]: {\n          ...prev[slotId],\n          status: \'verified\',\n          compressedKb: 310,\n          ocrMessage: \'Verified Ready (310 KB)\',\n        },\n      }));\n    }\n  };\n\n  // Instant simulation helper for UAT Scenario #3 (Blurry vs Clear Passport Photo)\n  const handleSimulatePassportClarity = async (makeBlurry: boolean) => {\n    const res = await fetch(\'/api/verify-kyc\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({\n        simulateMode: makeBlurry ? \'blur\' : \'clear\',\n      }),\n    });\n    const data = await res.json();\n    setKycDocs((prev) => ({\n      ...prev,\n      passport: {\n        id: \'passport\',\n        status: makeBlurry ? \'blurry\' : \'verified\',\n        fileName: makeBlurry\n          ? \'passport_glare_flash.jpg\'\n          : \'passport_aus_wright_clear.webp\',\n        compressedKb: makeBlurry ? 340 : 284,\n        ocrName: data.nama_lengkap || \'ALEXANDER WRIGHT\',\n        ocrNumber: data.nomor_identitas || \'PA8934120\',\n        ocrMessage: makeBlurry\n          ? \'Text unreadable due to glare/blur. Please retake photo clearly without flash.\'\n          : `AI OCR Verified: ${data.nama_lengkap || \'ALEXANDER WRIGHT\'} (${\n              data.nomor_identitas || \'PA8934120\'\n            }) \342\200\224 Clear`,\n      },\n    }));\n    if (!makeBlurry) {\n      setBookingFeedbackError(null);\n    }\n  };\n\n  // Toggle Selfie or Hotel Doc state in 1 click if user clicks without selecting file\n  const handleQuickCompleteDoc = (slotId: \'selfie\' | \'hotel\') => {\n    if (slotId === \'selfie\') {\n      setKycDocs((prev) => ({\n        ...prev,\n        selfie:\n          prev.selfie.status === \'verified\'\n            ? {\n                id: \'selfie\',\n                status: \'compressing\',\n                fileName: \'selfie_passport.jpg\',\n                compressedKb: 380,\n                ocrMessage: \'Compressing and Scanning...\',\n              }\n            : {\n                id: \'selfie\',\n                status: \'verified\',\n                fileName: \'selfie_passport.jpg\',\n                compressedKb: 380,\n                ocrMessage: \'Compressed: 380 KB \342\200\224 Face & ID Match Verified\',\n              },\n      }));\n    } else if (slotId === \'hotel\') {\n      setKycDocs((prev) => ({\n        ...prev,\n        hotel: {\n          id: \'hotel\',\n          status: \'verified\',\n          fileName: \'booking_haven_canggu_rm204.pdf\',\n          compressedKb: 215,\n          ocrMessage: \'215 KB \342\200\224 Room 204 Match Clear\',\n        },\n      }));\n    }\n  };\n\n  // Count validated KYC documents\n  const validatedDocCount = Object.values(kycDocs).filter(\n    (d) => d.status === \'verified\' || d.status === \'compressing\'\n  ).length;\n  const isPassportBlurry = kycDocs.passport.status === \'blurry\';\n\n  // Submit Booking to Endpoint 2 (POST /api/n8n/viyond-web-booking)\n  const handleSubmitBooking = async () => {\n    setIsSubmittingBooking(true);\n    setBookingFeedbackError(null);\n    try {\n      const res = await fetch(\'/api/n8n/viyond-web-booking\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          fullName,\n          whatsappNumber: `${countryCode} ${whatsappLocal}`,\n          nationality,\n          categoryId: selectedCategory.id,\n          categoryName: selectedCategory.name,\n          startDate,\n          endDate,\n          durationDays: rentalDays,\n          zoneId: selectedZone.id,\n          zoneLabel: `${selectedZone.code}: ${selectedZone.areaNames.split(\',\')[0]}`,\n          hotelAndRoom,\n          deliveryTime,\n          rentalSubtotal: priceBreakdown.rentalSubtotal,\n          deliveryFee: priceBreakdown.deliveryFee,\n          totalAmount: priceBreakdown.totalAmount,\n          paymentMethod,\n          idCardStatus: isPassportBlurry ? \'blurry\' : \'clear\',\n        }),\n      });\n      const data = await res.json();\n      if (!res.ok || data.status === \'error_blur\') {\n        setBookingFeedbackError(\n          data.message ||\n            \'AI Vision OCR rejected Passport/ID photo due to blur/glare. Please replace photo in Step 2.\'\n        );\n        return;\n      }\n      if (data.order) {\n        setActiveOrder(data.order);\n        setOrders((prev) => [\n          data.order,\n          ...prev.filter((o) => o.orderId !== data.order.orderId),\n        ]);\n        setWaMessages((prev) => [\n          ...prev,\n          {\n            sender: \'bot\',\n            text: data.order.whatsappMessagePreview,\n            time: new Date().toLocaleTimeString([], {\n              hour: \'2-digit\',\n              minute: \'2-digit\',\n            }),\n          },\n        ]);\n      }\n      if (data.categories) setCategories(data.categories);\n      if (data.inventarisMotor) setInventarisMotor(data.inventarisMotor);\n    } finally {\n      setIsSubmittingBooking(false);\n    }\n  };\n\n  // UAT Handlers\n  const handleToggleCategoryStock = async (\n    categoryId: \'nmax\' | \'pcx\' | \'scoopy\' | \'vario\' | \'fazzio\',\n    forceSoldOut?: boolean\n  ) => {\n    const res = await fetch(\'/api/n8n/viyond-live-inventory\', {\n      method: \'PATCH\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({\n        action: \'toggle_category\',\n        categoryId,\n        forceSoldOut,\n      }),\n    });\n    const data = await res.json();\n    if (data.categories) setCategories(data.categories);\n    if (data.inventarisMotor) setInventarisMotor(data.inventarisMotor);\n  };\n\n  const handleUpdateSingleUnit = async (\n    unitId: string,\n    status: \'READY\' | \'DISEWA\' | \'BENGKEL\'\n  ) => {\n    const res = await fetch(\'/api/n8n/viyond-live-inventory\', {\n      method: \'PATCH\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({\n        action: \'update_unit\',\n        unitId,\n        status,\n      }),\n    });\n    const data = await res.json();\n    if (data.categories) setCategories(data.categories);\n    if (data.inventarisMotor) setInventarisMotor(data.inventarisMotor);\n  };\n\n  const handleOwnerTelegramDecision = async (\n    orderId: string,\n    decision: \'approve\' | \'reject\'\n  ) => {\n    const res = await fetch(\'/api/n8n/viyond-web-booking\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({\n        action: \'telegram_owner_decision\',\n        orderId,\n        decision,\n      }),\n    });\n    const data = await res.json();\n    if (data.order) {\n      setActiveOrder(data.order);\n      setOrders((prev) =>\n        prev.map((o) => (o.orderId === data.order.orderId ? data.order : o))\n      );\n      setWaMessages((prev) => [\n        ...prev,\n        {\n          sender: \'bot\',\n          text: data.order.whatsappMessagePreview,\n          time: new Date().toLocaleTimeString([], {\n            hour: \'2-digit\',\n            minute: \'2-digit\',\n          }),\n        },\n      ]);\n    }\n    if (data.categories) setCategories(data.categories);\n    if (data.inventarisMotor) setInventarisMotor(data.inventarisMotor);\n  };\n\n  const handleSendWaChat = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!waChatInput.trim()) return;\n    const userMsg = waChatInput.trim();\n    setWaChatInput(\'\');\n    const now = new Date().toLocaleTimeString([], {\n      hour: \'2-digit\',\n      minute: \'2-digit\',\n    });\n    setWaMessages((prev) => [...prev, { sender: \'user\', text: userMsg, time: now }]);\n    setTimeout(() => {\n      setWaMessages((prev) => [\n        ...prev,\n        {\n          sender: \'bot\',\n          text: `VIYOND AI CS: Thank you, ${fullName}! Your ${selectedCategory.name} booking (#${activeOrder.orderId}) for ${hotelAndRoom} is synced with our Master DB. Every scooter comes with 2 sanitized helmets & phone holder. Need to adjust delivery time? Just reply here!`,\n          time: now,\n        },\n      ]);\n    }, 350);\n  };\n\n  const maxiUnits = categories.filter((c) => c.segment === \'maxi\');\n  const compactUnits = categories.filter((c) => c.segment === \'compact\');\n\n  return (\n    <div className=\"min-h-screen bg-[#02050a] text-slate-100 pb-20\">\n      {/* Top Bar Contract: Zone 1 (Brand) \342\200\224 Zone 2 (Navigation / View Switch) \342\200\224 Zone 3 (Primary Action) */}\n      <header className=\"sticky top-0 z-30 flex items-center justify-between gap-8 px-4 sm:px-8 py-3.5 bg-[#050b16]/90 backdrop-blur-md border-b border-blue-400/15\">\n        <a\n          href=\"#top\"\n          className=\"text-lg font-extrabold tracking-tight text-white whitespace-nowrap shrink-0\"\n        >\n          {siteConfig.brandName}\n        </a>\n\n        <nav className=\"hidden md:flex items-center gap-6 text-sm font-medium text-blue-200/80\">\n          <button\n            onClick={() => {\n              setViewMode(\'board\');\n            }}\n            className={`hover:text-white transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n              viewMode === \'board\' ? \'text-white underline underline-offset-8\' : \'\'\n            }`}\n          >\n            3-Step Showcase Board\n          </button>\n          <button\n            onClick={() => {\n              setViewMode(\'single\');\n              setActiveStep(1);\n            }}\n            className={`hover:text-white transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n              viewMode === \'single\' && activeStep === 1\n                ? \'text-white underline underline-offset-8\'\n                : \'\'\n            }`}\n          >\n            Step 1: Live Fleet\n          </button>\n          <button\n            onClick={() => {\n              setViewMode(\'single\');\n              setActiveStep(2);\n            }}\n            className={`hover:text-white transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n              viewMode === \'single\' && activeStep === 2\n                ? \'text-white underline underline-offset-8\'\n                : \'\'\n            }`}\n          >\n            Step 2: AI Vision KYC\n          </button>\n          <button\n            onClick={() => {\n              setViewMode(\'single\');\n              setActiveStep(3);\n            }}\n            className={`hover:text-white transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n              viewMode === \'single\' && activeStep === 3\n                ? \'text-white underline underline-offset-8\'\n                : \'\'\n            }`}\n          >\n            Step 3: Payment & WA Sync\n          </button>\n        </nav>\n\n        <div className=\"flex items-center gap-3 shrink-0\">\n          <button\n            onClick={() => setIsUatConsoleOpen(true)}\n            className=\"px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-500 rounded-xl transition-colors whitespace-nowrap shrink-0 flex items-center gap-2 cursor-pointer shadow-lg shadow-blue-600/25\"\n          >\n            <Sliders className=\"w-3.5 h-3.5\" />\n            <span>Telegram /stok & UAT Console</span>\n          </button>\n        </div>\n      </header>\n\n      {/* Top Showcase Banner (Matching the exact deep blue banner in design_UI_UX_V_35fb639f.svg) */}\n      <div className=\"max-w-[1360px] mx-auto px-4 sm:px-6 pt-5 pb-4\">\n        <div\n          className=\"rounded-[36px] px-6 py-7 sm:py-9 text-center border border-blue-400/20 shadow-2xl relative overflow-hidden\"\n          style={{\n            background:\n              \'linear-gradient(180deg, #1b5fd4 0%, #0a1d45 55%, #050b16 100%)\',\n          }}\n        >\n          <h1 className=\"text-3xl sm:text-5xl font-light tracking-tight text-white text-balance\">\n            Mobile-first booking wizard\n          </h1>\n          <p className=\"text-xs sm:text-sm italic text-[#b9ccf0] mt-2.5\">\n            {siteConfig.brandName} Agency \342\200\224 Smart Web Scooter Booking \302\267 3-step flow \302\267 Deep Blue Glass + Action UI\n          </p>\n          <div className=\"mt-4 flex flex-wrap items-center justify-center gap-3\">\n            <span className=\"text-xs text-[#8fa9d6]\">\n              Optimized mobile experience for all devices \302\267 Master DB Latency: {lastSyncLatencyMs}ms\n            </span>\n            <span className=\"text-blue-400/40\" aria-hidden=\"true\">\n              \302\267\n            </span>\n            <div className=\"inline-flex items-center bg-[#050b16]/60 p-1 rounded-xl border border-blue-400/20\">\n              <button\n                onClick={() => setViewMode(\'board\')}\n                className={`px-3 py-1 rounded-lg text-xs font-medium flex items-center gap-1.5 transition-colors cursor-pointer whitespace-nowrap ${\n                  viewMode === \'board\'\n                    ? \'bg-blue-600 text-white\'\n                    : \'text-blue-200/75 hover:text-white\'\n                }`}\n              >\n                <Columns3 className=\"w-3.5 h-3.5\" />\n                <span>3-Screen Board View</span>\n              </button>\n              <button\n                onClick={() => setViewMode(\'single\')}\n                className={`px-3 py-1 rounded-lg text-xs font-medium flex items-center gap-1.5 transition-colors cursor-pointer whitespace-nowrap ${\n                  viewMode === \'single\'\n                    ? \'bg-blue-600 text-white\'\n                    : \'text-blue-200/75 hover:text-white\'\n                }`}\n              >\n                <Smartphone className=\"w-3.5 h-3.5\" />\n                <span>Single Phone Wizard</span>\n              </button>\n            </div>\n            <button\n              onClick={() => setLang(lang === \'en\' ? \'id\' : \'en\')}\n              className=\"px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/15 border border-white/15 text-xs font-semibold text-white transition-colors cursor-pointer whitespace-nowrap\"\n            >\n              Language: {lang.toUpperCase()}\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Main 3-Step Interactive Canvas */}\n      <main className=\"max-w-[1360px] mx-auto px-4 sm:px-6\">\n        <div\n          className={\n            viewMode === \'board\'\n              ? \'grid grid-cols-1 lg:grid-cols-3 gap-7 items-start justify-items-center\'\n              : \'flex flex-col items-center justify-center\'\n          }\n        >\n          {/* =====================================================================\n              SCREEN 1: STEP 1 \302\267 HERO, LIVE CATALOG AND ZONE CALCULATOR\n             ===================================================================== */}\n          {(viewMode === \'board\' || activeStep === 1) && (\n            <section className=\"w-full max-w-[400px] flex flex-col\">\n              <div className=\"text-[11px] font-semibold tracking-wider text-[#8fa9d6] mb-2.5 px-1\">\n                STEP 1 \302\267 HERO, LIVE CATALOG AND ZONE CALCULATOR (390\303\2271700)\n              </div>\n\n              <div\n                className=\"relative w-full rounded-[48px] border border-blue-300/25 shadow-[0_24px_80px_rgba(15,45,110,0.55)] overflow-hidden flex flex-col justify-between p-5\"\n                style={{\n                  background:\n                    \'linear-gradient(180deg, #071430 0%, #0e2963 22%, #204d9e 48%, #4778c7 72%, #a8c5eb 88%, #cbe0f7 100%)\',\n                }}\n              >\n                {/* Top Dynamic Island Notch */}\n                <div className=\"w-24 h-6 bg-[#02050a] rounded-full mx-auto mb-3 opacity-90\" />\n\n                {/* Top App Bar */}\n                <div className=\"flex items-center justify-between mb-5\">\n                  <span className=\"text-lg font-black tracking-tighter text-white\">\n                    {siteConfig.brandName}\n                  </span>\n                  <div className=\"flex items-center gap-2\">\n                    <button\n                      onClick={() => setLang(lang === \'en\' ? \'id\' : \'en\')}\n                      className=\"h-9 px-3.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/25 text-xs font-semibold text-white transition-colors cursor-pointer whitespace-nowrap\"\n                    >\n                      EN / ID\n                    </button>\n                    <button\n                      onClick={() => setIsUatConsoleOpen(true)}\n                      className=\"w-9 h-9 rounded-full bg-white text-[#071430] hover:bg-blue-50 flex items-center justify-center transition-colors cursor-pointer\"\n                      aria-label=\"Open UAT & Master DB Menu\"\n                    >\n                      <Menu className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                </div>\n\n                {/* Hero Headline & Subtitle */}\n                <div className=\"mb-4\">\n                  <h2 className=\"text-[32px] leading-[1.08] font-bold tracking-tight text-white text-balance\">\n                    {t.heroTitleLine1}\n                    <br />\n                    {t.heroTitleLine2}\n                  </h2>\n                  <p className=\"text-xs text-blue-100/85 mt-2\">\n                    {t.heroSubtitle}\n                  </p>\n                </div>\n\n                {/* Trust Signals Row (Clean segmented row matching SVG) */}\n                <div className=\"grid grid-cols-3 gap-1.5 mb-3 text-[11px] font-medium text-blue-100\">\n                  <div className=\"py-2 px-2.5 rounded-full bg-[#0d224c]/70 border border-blue-300/25 text-center truncate\">\n                    \342\230\205 {t.trustGoogle}\n                  </div>\n                  <div className=\"py-2 px-2.5 rounded-full bg-[#0d224c]/70 border border-blue-300/25 text-center truncate\">\n                    {t.trustHelmet}\n                  </div>\n                  <div className=\"py-2 px-2.5 rounded-full bg-[#0d224c]/70 border border-blue-300/25 text-center truncate\">\n                    {t.trustInstant}\n                  </div>\n                </div>\n\n                {/* 3-Step Segmented Navigation */}\n                <div className=\"grid grid-cols-3 gap-1 p-1 rounded-full bg-[#0d224c]/60 border border-blue-300/25 mb-4\">\n                  <button\n                    onClick={() => setActiveStep(1)}\n                    className=\"py-2 px-2 rounded-full bg-white text-[#081530] text-[11px] font-bold truncate cursor-pointer\"\n                  >\n                    {t.step1Tab}\n                  </button>\n                  <button\n                    onClick={() => setActiveStep(2)}\n                    className=\"py-2 px-2 rounded-full text-blue-100/80 hover:text-white text-[11px] font-medium truncate cursor-pointer\"\n                  >\n                    {t.step2Tab}\n                  </button>\n                  <button\n                    onClick={() => setActiveStep(3)}\n                    className=\"py-2 px-2 rounded-full text-blue-100/80 hover:text-white text-[11px] font-medium truncate cursor-pointer\"\n                  >\n                    {t.step3Tab}\n                  </button>\n                </div>\n\n                {/* Select Rental Period Card */}\n                <div className=\"rounded-[26px] bg-[#16336b]/70 backdrop-blur-md border border-blue-300/30 p-4 mb-5\">\n                  <div className=\"text-xs font-medium text-blue-100 mb-2.5\">\n                    {t.selectRentalPeriod}\n                  </div>\n                  <div className=\"grid grid-cols-2 gap-3 mb-3\">\n                    <div>\n                      <label className=\"block text-[10px] font-semibold tracking-wider text-blue-200/70 mb-1\">\n                        {t.startDate}\n                      </label>\n                      <input\n                        type=\"date\"\n                        value={startDate}\n                        onChange={(e) => setStartDate(e.target.value)}\n                        className=\"w-full bg-[#0a1b3d]/60 border border-blue-300/25 rounded-xl px-2.5 py-1.5 text-xs font-semibold text-white focus:outline-none focus:border-white\"\n                      />\n                      <div className=\"text-[10px] text-blue-200/80 mt-1 font-mono\">\n                        {formatDisplayDate(startDate)}\n                      </div>\n                    </div>\n                    <div>\n                      <label className=\"block text-[10px] font-semibold tracking-wider text-blue-200/70 mb-1\">\n                        {t.endDate} ({rentalDays} {t.daysUnit})\n                      </label>\n                      <input\n                        type=\"date\"\n                        value={endDate}\n                        min={startDate}\n                        onChange={(e) => setEndDate(e.target.value)}\n                        className=\"w-full bg-[#0a1b3d]/60 border border-blue-300/25 rounded-xl px-2.5 py-1.5 text-xs font-semibold text-white focus:outline-none focus:border-white\"\n                      />\n                      <div className=\"text-[10px] text-blue-200/80 mt-1 font-mono\">\n                        {formatDisplayDate(endDate)}\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Check Live Stock (n8n Sync) Button Row */}\n                  <div className=\"flex items-center gap-2\">\n                    <button\n                      onClick={fetchLiveInventory}\n                      className=\"flex-1 h-11 rounded-full bg-white hover:bg-blue-50 text-[#081530] text-xs font-bold flex items-center justify-center gap-2 transition-transform active:scale-[0.99] cursor-pointer shadow-md\"\n                    >\n                      {isSyncingStock && (\n                        <RefreshCw className=\"w-3.5 h-3.5 animate-spin text-blue-600\" />\n                      )}\n                      <span>\n                        {isSyncingStock ? t.syncingStock : t.checkLiveStockBtn}\n                      </span>\n                    </button>\n                    <button\n                      onClick={fetchLiveInventory}\n                      className=\"w-11 h-11 rounded-full bg-[#1d63dc] hover:bg-blue-500 text-white flex items-center justify-center shrink-0 transition-colors cursor-pointer shadow-md\"\n                      aria-label=\"Sync Live Stock\"\n                    >\n                      <ArrowUpRight className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                </div>\n\n                {/* Live Fleet Catalog Header */}\n                <div className=\"flex items-center justify-between mb-3\">\n                  <h3 className=\"text-xl font-bold tracking-tight text-white\">\n                    {t.liveFleetCatalog}\n                  </h3>\n                  <div className=\"flex items-center gap-1.5\">\n                    <button\n                      onClick={() => setCatalogFilter(\'all\')}\n                      className={`h-8 px-3.5 rounded-full text-xs font-bold transition-colors cursor-pointer ${\n                        catalogFilter === \'all\'\n                          ? \'bg-white text-[#081530]\'\n                          : \'bg-[#122b5e]/80 text-blue-100 border border-blue-300/30\'\n                      }`}\n                    >\n                      {t.allUnits}\n                    </button>\n                    <button\n                      onClick={() =>\n                        setCatalogFilter(\n                          catalogFilter === \'available\' ? \'all\' : \'available\'\n                        )\n                      }\n                      className={`h-8 px-3.5 rounded-full text-xs font-semibold transition-colors cursor-pointer ${\n                        catalogFilter === \'available\'\n                          ? \'bg-white text-[#081530]\'\n                          : \'bg-[#122b5e]/80 text-blue-100 border border-blue-300/30\'\n                      }`}\n                    >\n                      {t.filters}\n                    </button>\n                  </div>\n                </div>\n\n                {/* Featured Maxi Unit 1: Yamaha NMAX 155 */}\n                {maxiUnits\n                  .filter((u) =>\n                    catalogFilter === \'available\' ? u.isAvailable : true\n                  )\n                  .map((unit) => {\n                    const isSelected = selectedCategoryId === unit.id;\n                    if (!unit.isAvailable) {\n                      // Sold Out Card (e.g. Honda PCX 160 by default)\n                      return (\n                        <div\n                          key={unit.id}\n                          className=\"rounded-[26px] bg-[#0d1f45]/90 border border-blue-300/20 p-4 mb-3.5 text-slate-300\"\n                        >\n                          <div className=\"flex items-center justify-between text-xs mb-2\">\n                            <span className=\"font-semibold text-rose-400\">\n                              \342\227\217 {t.soldOut}\n                            </span>\n                            <span className=\"font-mono text-slate-400 tabular-nums\">\n                              Rp {unit.dailyPrice / 1000}k/day\n                            </span>\n                          </div>\n                          <div className=\"flex items-center justify-between gap-2\">\n                            <div>\n                              <h4 className=\"text-lg font-bold text-slate-300/80\">\n                                {unit.name}\n                              </h4>\n                              <p className=\"text-[11px] text-slate-400 mt-0.5\">\n                                {t.allUnitsRented}\n                              </p>\n                            </div>\n                            <button\n                              onClick={() => handleToggleCategoryStock(unit.id, false)}\n                              className=\"px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/15 border border-white/10 text-[10px] font-mono text-blue-200 transition-colors cursor-pointer shrink-0\"\n                              title=\"Simulate Telegram /stok command to make READY\"\n                            >\n                              /stok \342\206\222 Set Ready\n                            </button>\n                          </div>\n                          <div className=\"mt-3 pt-2.5 border-t border-white/10 text-center text-xs text-slate-400 font-medium\">\n                            {t.unavailableForDates}\n                          </div>\n                        </div>\n                      );\n                    }\n\n                    return (\n                      <div\n                        key={unit.id}\n                        onClick={() => setSelectedCategoryId(unit.id)}\n                        className={`rounded-[28px] p-4 mb-3.5 border transition-all cursor-pointer ${\n                          isSelected\n                            ? \'border-white/60 shadow-[0_12px_35px_rgba(14,35,82,0.65)]\'\n                            : \'border-blue-300/30 opacity-95 hover:border-white/40\'\n                        }`}\n                        style={{\n                          background:\n                            \'linear-gradient(180deg, #6e94d9 0%, #31539e 52%, #102147 100%)\',\n                        }}\n                      >\n                        <div className=\"flex items-center justify-between text-xs mb-1\">\n                          <span className=\"font-semibold text-emerald-300\">\n                            \342\227\217 {unit.availableUnits} {t.unitsAvailable}\n                          </span>\n                          <span className=\"font-mono font-semibold text-white tabular-nums\">\n                            Rp {unit.dailyPrice / 1000}k/day\n                          </span>\n                        </div>\n\n                        <ScooterSilhouette variant={unit.id} size=\"lg\" />\n\n                        <div className=\"flex items-end justify-between gap-2 mt-1\">\n                          <div>\n                            <h4 className=\"text-2xl font-bold tracking-tight text-white\">\n                              {unit.name}\n                            </h4>\n                            <p className=\"text-xs text-blue-100/90 mt-0.5\">\n                              {lang === \'en\' ? unit.specsEn : unit.specsId}\n                            </p>\n                            <p className=\"text-[11px] text-blue-200/80 font-mono tabular-nums mt-0.5\">\n                              Weekly: Rp {unit.weeklyPrice / 1000}k \302\267 Monthly: Rp{\' \'}\n                              {(unit.monthlyPrice / 1000000).toFixed(1)}M\n                            </p>\n                          </div>\n                          <span className=\"text-[10px] font-mono text-blue-200/60\">\n                            [{unit.imageFile}]\n                          </span>\n                        </div>\n\n                        <div className=\"flex items-center gap-2 mt-3.5\">\n                          <button\n                            type=\"button\"\n                            onClick={(e) => {\n                              e.stopPropagation();\n                              setSelectedCategoryId(unit.id);\n                            }}\n                            className={`flex-1 h-11 rounded-full text-xs font-bold flex items-center justify-center transition-colors cursor-pointer ${\n                              isSelected\n                                ? \'bg-white text-[#081530]\'\n                                : \'bg-white/15 text-white hover:bg-white/25\'\n                            }`}\n                          >\n                            {isSelected ? t.selectedForBooking : t.selectUnit}\n                          </button>\n                          <button\n                            type=\"button\"\n                            onClick={(e) => {\n                              e.stopPropagation();\n                              setSelectedCategoryId(unit.id);\n                              setActiveStep(2);\n                            }}\n                            className=\"w-11 h-11 rounded-full bg-[#1d63dc] hover:bg-blue-500 text-white flex items-center justify-center shrink-0 transition-colors cursor-pointer\"\n                            aria-label=\"Select and Continue\"\n                          >\n                            <ArrowUpRight className=\"w-4 h-4\" />\n                          </button>\n                        </div>\n                      </div>\n                    );\n                  })}\n\n                {/* 3-Column Compact Scooter Cards (Scoopy, Vario 160, Fazzio) */}\n                <div className=\"grid grid-cols-3 gap-2 mb-4\">\n                  {compactUnits.map((unit) => {\n                    const isSelected = selectedCategoryId === unit.id;\n                    return (\n                      <div\n                        key={unit.id}\n                        onClick={() =>\n                          unit.isAvailable && setSelectedCategoryId(unit.id)\n                        }\n                        className={`rounded-[22px] p-2.5 border transition-all flex flex-col justify-between cursor-pointer ${\n                          isSelected\n                            ? \'bg-[#1a3e82]/90 border-white shadow-lg\'\n                            : \'bg-[#1b3c7d]/60 border-blue-200/30 hover:bg-[#1b3c7d]/80\'\n                        }`}\n                      >\n                        <div className=\"text-[10px] font-semibold text-emerald-300 truncate\">\n                          \342\227\217 {unit.availableUnits} {t.readySuffix}\n                        </div>\n\n                        <ScooterSilhouette variant={unit.id} size=\"sm\" />\n\n                        <div>\n                          <div className=\"text-xs font-bold text-white truncate\">\n                            {unit.shortName}\n                          </div>\n                          <div className=\"text-[10px] text-blue-100/80 font-mono tabular-nums\">\n                            Rp {unit.dailyPrice / 1000}k/day\n                          </div>\n                          <button\n                            type=\"button\"\n                            className={`mt-2 w-full py-1.5 rounded-full text-[11px] font-bold transition-colors cursor-pointer ${\n                              isSelected\n                                ? \'bg-[#1d63dc] text-white\'\n                                : \'bg-white text-[#081530] hover:bg-blue-50\'\n                            }`}\n                          >\n                            {isSelected ? \'Selected\' : t.selectUnit}\n                          </button>\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n\n                {/* Delivery Zone and Hotel Details (ZONA_ONGKIR) */}\n                <div className=\"rounded-[28px] bg-[#0d1f45]/95 border border-blue-300/25 p-4 mb-3.5 text-white\">\n                  <h4 className=\"text-base font-bold tracking-tight\">\n                    {t.deliveryZoneTitle}\n                  </h4>\n                  <p className=\"text-[11px] text-blue-200/70 mb-3\">\n                    {t.syncedWithTab}\n                  </p>\n\n                  <div className=\"space-y-2.5\">\n                    {/* Zone Dropdown */}\n                    <div className=\"rounded-2xl bg-[#162d5e]/80 border border-blue-300/20 px-3.5 py-2.5 flex items-center justify-between gap-2\">\n                      <div className=\"flex-1 min-w-0\">\n                        <label className=\"block text-[9px] font-semibold tracking-wider text-blue-200/70\">\n                          {t.deliveryAreaZone}\n                        </label>\n                        <select\n                          value={selectedZoneId}\n                          onChange={(e) => setSelectedZoneId(e.target.value)}\n                          className=\"w-full bg-transparent text-xs font-semibold text-white focus:outline-none cursor-pointer truncate mt-0.5\"\n                        >\n                          {zones.map((z) => (\n                            <option\n                              key={z.id}\n                              value={z.id}\n                              className=\"bg-[#09152e] text-white\"\n                            >\n                              {lang === \'en\' ? z.labelEn : z.labelId}\n                            </option>\n                          ))}\n                        </select>\n                      </div>\n                      <ArrowUpRight className=\"w-3.5 h-3.5 text-blue-200 shrink-0\" />\n                    </div>\n\n                    {/* Hotel & Room Input */}\n                    <div className=\"rounded-2xl bg-[#162d5e]/80 border border-blue-300/20 px-3.5 py-2.5 flex items-center justify-between gap-2\">\n                      <div className=\"flex-1 min-w-0\">\n                        <label className=\"block text-[9px] font-semibold tracking-wider text-blue-200/70\">\n                          {t.hotelVillaRoom}\n                        </label>\n                        <input\n                          type=\"text\"\n                          value={hotelAndRoom}\n                          onChange={(e) => setHotelAndRoom(e.target.value)}\n                          placeholder=\"e.g. The Haven Suites Canggu \342\200\224 Room 204\"\n                          className=\"w-full bg-transparent text-xs font-semibold text-white focus:outline-none mt-0.5\"\n                        />\n                      </div>\n                      <ArrowUpRight className=\"w-3.5 h-3.5 text-blue-200 shrink-0\" />\n                    </div>\n\n                    {/* Preferred Delivery Time */}\n                    <div className=\"rounded-2xl bg-[#162d5e]/80 border border-blue-300/20 px-3.5 py-2.5 flex items-center justify-between gap-2\">\n                      <div className=\"flex-1 min-w-0\">\n                        <label className=\"block text-[9px] font-semibold tracking-wider text-blue-200/70\">\n                          {t.preferredDeliveryTime}\n                        </label>\n                        <select\n                          value={deliveryTime}\n                          onChange={(e) => setDeliveryTime(e.target.value)}\n                          className=\"w-full bg-transparent text-xs font-semibold text-white focus:outline-none cursor-pointer truncate mt-0.5\"\n                        >\n                          {DELIVERY_TIME_SLOTS.map((slot) => (\n                            <option\n                              key={slot.value}\n                              value={slot.value}\n                              className=\"bg-[#09152e] text-white\"\n                            >\n                              {lang === \'en\' ? slot.labelEn : slot.labelId}\n                            </option>\n                          ))}\n                        </select>\n                      </div>\n                      <ArrowUpRight className=\"w-3.5 h-3.5 text-blue-200 shrink-0\" />\n                    </div>\n                  </div>\n                </div>\n\n                {/* Bilingual Rental Terms & Insurance FAQ Accordion */}\n                <div className=\"rounded-[24px] bg-[#486da8]/55 backdrop-blur-md border border-white/30 px-4 py-3 mb-4 text-white\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setFaqOpen(!faqOpen)}\n                    className=\"w-full flex items-center justify-between text-left cursor-pointer\"\n                  >\n                    <span className=\"text-xs font-semibold text-white/95\">\n                      {t.rentalTermsFaqTitle}\n                    </span>\n                    <span className=\"w-8 h-8 rounded-full bg-white text-[#09152e] flex items-center justify-center shrink-0\">\n                      {faqOpen ? (\n                        <Minus className=\"w-4 h-4\" />\n                      ) : (\n                        <Plus className=\"w-4 h-4\" />\n                      )}\n                    </span>\n                  </button>\n                  {faqOpen && (\n                    <div className=\"mt-3 pt-3 border-t border-white/20 space-y-2.5 text-xs\">\n                      {t.termsItems.map((item, idx) => (\n                        <div key={idx} className=\"bg-[#0a1938]/75 rounded-xl p-3\">\n                          <div className=\"font-bold text-white\">{item.q}</div>\n                          <div className=\"text-blue-100/85 mt-1 leading-relaxed\">\n                            {item.a}\n                          </div>\n                        </div>\n                      ))}\n                    </div>\n                  )}\n                </div>\n\n                {/* Sticky Price Summary (Kotak Ringkasan Harga Otomatis) */}\n                <div className=\"rounded-[32px] bg-[#0b1938] border border-blue-300/25 p-4 text-white shadow-xl\">\n                  <div className=\"text-[11px] text-blue-200/85 font-mono truncate\">\n                    {lang === \'en\'\n                      ? priceBreakdown.formulaSummaryEn\n                      : priceBreakdown.formulaSummaryId}\n                  </div>\n                  <div className=\"text-[11px] text-blue-300/75 mt-0.5\">\n                    {t.totalEstimate} \302\267 {selectedCategory.name}\n                  </div>\n                  <div className=\"flex items-baseline justify-between mt-0.5 mb-3\">\n                    <span className=\"text-3xl font-extrabold tracking-tight font-mono tabular-nums\">\n                      {formatIdr(priceBreakdown.totalAmount)}\n                    </span>\n                    <span className=\"text-[11px] text-blue-200/85\">\n                      {t.autoTiered}\n                    </span>\n                  </div>\n\n                  <div className=\"flex items-center gap-2\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setActiveStep(2)}\n                      className=\"flex-1 h-12 rounded-full bg-white hover:bg-blue-50 text-[#081530] text-xs font-bold flex items-center justify-center transition-transform active:scale-[0.99] cursor-pointer\"\n                    >\n                      {t.continueToVerification}\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => setActiveStep(2)}\n                      className=\"w-12 h-12 rounded-full bg-[#1d63dc] hover:bg-blue-500 text-white flex items-center justify-center shrink-0 transition-colors cursor-pointer\"\n                      aria-label=\"Continue to Step 2\"\n                    >\n                      <ArrowUpRight className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </section>\n          )}\n\n          {/* =====================================================================\n              SCREEN 2: STEP 2 \302\267 ENHANCED KYC UPLOAD AND AI VISION OCR\n             ===================================================================== */}\n          {(viewMode === \'board\' || activeStep === 2) && (\n            <section className=\"w-full max-w-[400px] flex flex-col\">\n              <div className=\"text-[11px] font-semibold tracking-wider text-[#8fa9d6] mb-2.5 px-1\">\n                STEP 2 \302\267 ENHANCED KYC UPLOAD AND AI VISION OCR (390\303\2271700)\n              </div>\n\n              <div\n                className=\"relative w-full rounded-[48px] border border-white/50 shadow-[0_24px_80px_rgba(15,45,110,0.45)] overflow-hidden flex flex-col justify-between p-5 text-[#091329]\"\n                style={{\n                  background:\n                    \'linear-gradient(180deg, #f1f4fa 0%, #e5ecf8 55%, #dce4f2 100%)\',\n                }}\n              >\n                {/* Top Dynamic Island Notch */}\n                <div className=\"w-24 h-6 bg-[#02050a] rounded-full mx-auto mb-3\" />\n\n                {/* Top App Bar */}\n                <div className=\"flex items-center justify-between mb-4\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveStep(1)}\n                    className=\"w-9 h-9 rounded-full bg-[#091329] text-white flex items-center justify-center cursor-pointer\"\n                    aria-label=\"Back to Step 1\"\n                  >\n                    <ChevronLeft className=\"w-4 h-4\" />\n                  </button>\n                  <span className=\"text-xs font-bold text-[#091329]\">\n                    {t.step2Header}\n                  </span>\n                  <button\n                    type=\"button\"\n                    onClick={() => setIsUatConsoleOpen(true)}\n                    className=\"w-9 h-9 rounded-full bg-[#091329] text-white flex items-center justify-center cursor-pointer\"\n                    aria-label=\"Open UAT Menu\"\n                  >\n                    <Menu className=\"w-4 h-4\" />\n                  </button>\n                </div>\n\n                {/* 3-Step Segmented Navigation */}\n                <div className=\"grid grid-cols-3 gap-1 p-1 rounded-full bg-[#d0dced] border border-[#b8c8e3] mb-5\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveStep(1)}\n                    className=\"py-2 px-2 rounded-full text-[#34497c] hover:text-[#091329] text-[11px] font-semibold truncate cursor-pointer\"\n                  >\n                    1. Unit\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveStep(2)}\n                    className=\"py-2 px-2 rounded-full bg-[#091329] text-white text-[11px] font-bold truncate cursor-pointer\"\n                  >\n                    {t.step2Tab}\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveStep(3)}\n                    className=\"py-2 px-2 rounded-full text-[#34497c] hover:text-[#091329] text-[11px] font-semibold truncate cursor-pointer\"\n                  >\n                    {t.step3Tab}\n                  </button>\n                </div>\n\n                {/* Title & Subtitle */}\n                <div className=\"mb-4\">\n                  <h2 className=\"text-[30px] leading-tight font-bold tracking-tight text-[#091329]\">\n                    {t.instantVerificationTitle}\n                  </h2>\n                  <p className=\"text-xs text-[#425884] mt-1\">\n                    {t.instantVerificationSub}\n                  </p>\n                </div>\n\n                {/* Renter Contact Details Card */}\n                <div className=\"rounded-[28px] bg-white/85 border border-white p-4 mb-5 shadow-sm\">\n                  <div className=\"text-xs font-bold text-[#2563eb] mb-3\">\n                    {t.renterContactDetails}\n                  </div>\n\n                  <div className=\"space-y-2.5\">\n                    {/* Full Name */}\n                    <div className=\"rounded-2xl bg-[#eef2f9] px-3.5 py-2.5\">\n                      <label className=\"block text-[9px] font-semibold tracking-wider text-[#64748b]\">\n                        {t.fullNameLabel}\n                      </label>\n                      <input\n                        type=\"text\"\n                        value={fullName}\n                        onChange={(e) => setFullName(e.target.value)}\n                        className=\"w-full bg-transparent text-xs font-bold text-[#091329] focus:outline-none mt-0.5\"\n                      />\n                    </div>\n\n                    {/* Active WhatsApp Number */}\n                    <div className=\"rounded-2xl bg-[#eef2f9] px-3.5 py-2.5\">\n                      <label className=\"block text-[9px] font-semibold tracking-wider text-[#64748b]\">\n                        {t.whatsappLabel}\n                      </label>\n                      <div className=\"flex items-center gap-2 mt-0.5\">\n                        <select\n                          value={countryCode}\n                          onChange={(e) => setCountryCode(e.target.value)}\n                          className=\"bg-white rounded-lg px-2 py-0.5 text-xs font-bold text-emerald-600 focus:outline-none cursor-pointer\"\n                        >\n                          <option value=\"+61\">+61</option>\n                          <option value=\"+62\">+62</option>\n                          <option value=\"+7\">+7</option>\n                          <option value=\"+1\">+1</option>\n                          <option value=\"+44\">+44</option>\n                          <option value=\"+33\">+33</option>\n                        </select>\n                        <input\n                          type=\"text\"\n                          value={whatsappLocal}\n                          onChange={(e) => setWhatsappLocal(e.target.value)}\n                          className=\"flex-1 bg-transparent text-xs font-bold font-mono text-[#091329] focus:outline-none\"\n                        />\n                      </div>\n                    </div>\n\n                    {/* Nationality */}\n                    <div className=\"rounded-2xl bg-[#eef2f9] px-3.5 py-2.5\">\n                      <label className=\"block text-[9px] font-semibold tracking-wider text-[#64748b]\">\n                        {t.nationalityLabel}\n                      </label>\n                      <select\n                        value={nationality}\n                        onChange={(e) => setNationality(e.target.value)}\n                        className=\"w-full bg-transparent text-xs font-bold text-[#091329] focus:outline-none cursor-pointer mt-0.5\"\n                      >\n                        <option value=\"Australia (Verified Foreign Tourist)\">\n                          Australia (Verified Foreign Tourist)\n                        </option>\n                        <option value=\"United Kingdom (Verified Foreign Tourist)\">\n                          United Kingdom (Verified Foreign Tourist)\n                        </option>\n                        <option value=\"Russia (Verified Foreign Tourist)\">\n                          Russia (Verified Foreign Tourist)\n                        </option>\n                        <option value=\"United States (Verified Foreign Tourist)\">\n                          United States (Verified Foreign Tourist)\n                        </option>\n                        <option value=\"Indonesia (Domestic Tourist / KTP)\">\n                          Indonesia (Domestic Tourist / KTP)\n                        </option>\n                      </select>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Upload 4 Mandatory KYC Documents */}\n                <div className=\"mb-3 flex items-center justify-between\">\n                  <h3 className=\"text-sm font-bold text-[#091329]\">\n                    {t.upload4DocsTitle}\n                  </h3>\n                  <button\n                    type=\"button\"\n                    onClick={() =>\n                      handleSimulatePassportClarity(!isPassportBlurry)\n                    }\n                    className=\"text-[11px] font-semibold text-blue-700 hover:underline cursor-pointer\"\n                  >\n                    {isPassportBlurry ? \'Fix Glare (Test Clear)\' : \'Test Blur Alert\'}\n                  </button>\n                </div>\n\n                {/* Hidden File Inputs */}\n                {([\'passport\', \'selfie\', \'flight\', \'hotel\'] as const).map(\n                  (slotKey) => (\n                    <input\n                      key={slotKey}\n                      ref={fileInputRefs[slotKey]}\n                      type=\"file\"\n                      accept=\"image/*,.pdf\"\n                      className=\"hidden\"\n                      onChange={(e) => {\n                        const f = e.target.files?.[0];\n                        if (f) handleFileUpload(slotKey, f);\n                      }}\n                    />\n                  )\n                )}\n\n                <div className=\"space-y-3 mb-4\">\n                  {/* DOC 1: Passport / ID Card (KTP) */}\n                  <div\n                    className={`rounded-[26px] p-4 text-white transition-all border ${\n                      isPassportBlurry\n                        ? \'border-rose-400/80 shadow-[0_8px_25px_rgba(244,63,94,0.22)]\'\n                        : \'border-emerald-300/60\'\n                    }`}\n                    style={{\n                      background:\n                        \'linear-gradient(180deg, #7189ba 0%, #34497c 100%)\',\n                    }}\n                  >\n                    <div className=\"flex items-center justify-between gap-2 mb-1.5\">\n                      {isPassportBlurry ? (\n                        <span className=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-rose-950/65 border border-rose-400/50 text-[11px] font-bold text-rose-200\">\n                          \342\227\217 AI OCR: Photo is Blurry\n                        </span>\n                      ) : (\n                        <span className=\"inline-flex items-center gap-1.5 text-xs font-bold text-emerald-300\">\n                          \342\227\217 Verified Ready ({kycDocs.passport.compressedKb} KB)\n                        </span>\n                      )}\n                      <button\n                        type=\"button\"\n                        onClick={() =>\n                          handleSimulatePassportClarity(!isPassportBlurry)\n                        }\n                        className=\"text-[10px] font-mono text-blue-100/90 underline cursor-pointer\"\n                      >\n                        {isPassportBlurry ? \'[Simulate Clear]\' : \'[Simulate Blur]\'}\n                      </button>\n                    </div>\n\n                    <div className=\"text-sm font-bold\">{t.doc1Title}</div>\n                    <p\n                      className={`text-[11px] mt-0.5 leading-snug ${\n                        isPassportBlurry ? \'text-rose-100\' : \'text-blue-100\'\n                      }`}\n                    >\n                      {kycDocs.passport.ocrMessage}\n                    </p>\n\n                    <div className=\"flex items-center gap-2 mt-3\">\n                      <button\n                        type=\"button\"\n                        onClick={() => {\n                          if (isPassportBlurry) {\n                            handleSimulatePassportClarity(false);\n                          } else {\n                            fileInputRefs.passport.current?.click();\n                          }\n                        }}\n                        className=\"flex-1 h-10 rounded-full bg-white hover:bg-blue-50 text-[#091329] text-xs font-bold flex items-center justify-center transition-colors cursor-pointer\"\n                      >\n                        {isPassportBlurry\n                          ? t.retakeReplacePhoto\n                          : \'Upload Custom ID Photo\'}\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => fileInputRefs.passport.current?.click()}\n                        className=\"w-10 h-10 rounded-full bg-[#091329] text-white flex items-center justify-center shrink-0 cursor-pointer\"\n                        title=\"Choose file from device\"\n                      >\n                        <ArrowUpRight className=\"w-4 h-4\" />\n                      </button>\n                    </div>\n                  </div>\n\n                  {/* DOC 2: Selfie Holding Your ID/Passport */}\n                  <div\n                    onClick={() => handleQuickCompleteDoc(\'selfie\')}\n                    className=\"rounded-[26px] p-4 text-white border border-white/30 cursor-pointer\"\n                    style={{\n                      background:\n                        \'linear-gradient(180deg, #7189ba 0%, #34497c 100%)\',\n                    }}\n                  >\n                    <div className=\"flex items-center justify-between text-xs mb-1\">\n                      <span\n                        className={`font-semibold ${\n                          kycDocs.selfie.status === \'verified\'\n                            ? \'text-emerald-300\'\n                            : \'text-blue-200\'\n                        }`}\n                      >\n                        \342\227\217{\' \'}\n                        {kycDocs.selfie.status === \'verified\'\n                          ? \'Verified Ready\'\n                          : \'Compressing and Scanning...\'}\n                      </span>\n                      <button\n                        type=\"button\"\n                        onClick={(e) => {\n                          e.stopPropagation();\n                          fileInputRefs.selfie.current?.click();\n                        }}\n                        className=\"text-[10px] underline text-blue-100\"\n                      >\n                        Upload File\n                      </button>\n                    </div>\n                    <div className=\"text-sm font-bold\">{t.doc2Title}</div>\n                    <div className=\"text-[11px] text-blue-100/90 font-mono mt-0.5\">\n                      {kycDocs.selfie.fileName} (Compressed:{\' \'}\n                      {kycDocs.selfie.compressedKb} KB)\n                    </div>\n                    <div className=\"w-full h-1.5 rounded-full bg-[#1e2f57] mt-2.5 overflow-hidden\">\n                      <div\n                        className={`h-full rounded-full transition-all duration-300 ${\n                          kycDocs.selfie.status === \'verified\'\n                            ? \'w-full bg-emerald-400\'\n                            : \'w-3/4 bg-white\'\n                        }`}\n                      />\n                    </div>\n                  </div>\n\n                  {/* DOC 3: Return Flight Ticket Screenshot */}\n                  <div\n                    className=\"rounded-[26px] p-4 text-white border border-white/30 flex items-center justify-between gap-2\"\n                    style={{\n                      background:\n                        \'linear-gradient(180deg, #7189ba 0%, #34497c 100%)\',\n                    }}\n                  >\n                    <div className=\"min-w-0\">\n                      <div className=\"text-xs font-semibold text-emerald-300 mb-0.5\">\n                        \342\227\217 Verified Ready\n                      </div>\n                      <div className=\"text-sm font-bold truncate\">\n                        {t.doc3Title}\n                      </div>\n                      <div className=\"text-[11px] text-blue-100/90 font-mono truncate mt-0.5\">\n                        {kycDocs.flight.fileName} ({kycDocs.flight.compressedKb}{\' \'}\n                        KB) \342\200\224 {kycDocs.flight.ocrMessage}\n                      </div>\n                    </div>\n                    <button\n                      type=\"button\"\n                      onClick={() => fileInputRefs.flight.current?.click()}\n                      className=\"px-3.5 py-1.5 rounded-full bg-white text-[#091329] text-xs font-bold shrink-0 cursor-pointer hover:bg-blue-50\"\n                    >\n                      {t.changeBtn}\n                    </button>\n                  </div>\n\n                  {/* DOC 4: Hotel / Villa Booking Confirmation */}\n                  <div\n                    className=\"rounded-[26px] p-4 text-white border border-white/30\"\n                    style={{\n                      background:\n                        \'linear-gradient(180deg, #7189ba 0%, #34497c 100%)\',\n                    }}\n                  >\n                    {kycDocs.hotel.status === \'verified\' && (\n                      <div className=\"text-xs font-semibold text-emerald-300 mb-0.5\">\n                        \342\227\217 Verified Ready\n                      </div>\n                    )}\n                    <div className=\"text-sm font-bold\">{t.doc4Title}</div>\n                    <div className=\"text-[11px] text-blue-100/90 mt-0.5\">\n                      {kycDocs.hotel.status === \'verified\'\n                        ? `${kycDocs.hotel.fileName} (${kycDocs.hotel.compressedKb} KB)`\n                        : kycDocs.hotel.ocrMessage}\n                    </div>\n                    <div className=\"flex items-center gap-2 mt-3\">\n                      <button\n                        type=\"button\"\n                        onClick={() => handleQuickCompleteDoc(\'hotel\')}\n                        className=\"flex-1 h-10 rounded-full bg-white hover:bg-blue-50 text-[#091329] text-xs font-bold flex items-center justify-center cursor-pointer\"\n                      >\n                        {kycDocs.hotel.status === \'verified\'\n                          ? \'Re-upload Booking File\'\n                          : t.tapToUploadFile}\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => fileInputRefs.hotel.current?.click()}\n                        className=\"w-10 h-10 rounded-full bg-[#091329] text-white flex items-center justify-center shrink-0 cursor-pointer\"\n                        title=\"Upload Hotel PDF/Image\"\n                      >\n                        <ArrowUpRight className=\"w-4 h-4\" />\n                      </button>\n                    </div>\n                  </div>\n                </div>\n\n                {/* UU PDP Compliance Checkbox */}\n                <label className=\"rounded-[24px] bg-white/90 border border-white p-3.5 mb-4 flex items-start gap-3 cursor-pointer shadow-sm\">\n                  <input\n                    type=\"checkbox\"\n                    checked={pdpAgreed}\n                    onChange={(e) => setPdpAgreed(e.target.checked)}\n                    className=\"sr-only\"\n                  />\n                  <span\n                    className={`w-6 h-6 rounded-lg flex items-center justify-center shrink-0 mt-0.5 transition-colors ${\n                      pdpAgreed\n                        ? \'bg-[#2563eb] text-white\'\n                        : \'bg-slate-200 text-transparent\'\n                    }`}\n                  >\n                    <Check className=\"w-4 h-4 stroke-[3]\" />\n                  </span>\n                  <span className=\"text-[11px] text-[#334155] leading-relaxed\">\n                    {t.pdpConsentPart1}\n                    <strong className=\"text-[#2563eb] font-semibold\">\n                      {t.pdpConsentHighlight}\n                    </strong>\n                    .\n                  </span>\n                </label>\n\n                {/* Sticky Bottom Validation Status & Continue */}\n                <div className=\"rounded-[32px] bg-[#0b1938] p-4 text-white shadow-xl\">\n                  <div className=\"flex items-center justify-between text-[11px] mb-2.5\">\n                    {isPassportBlurry ? (\n                      <span className=\"font-semibold text-rose-300\">\n                        \342\227\217 {validatedDocCount}/4 Documents Validated \342\200\224 Fix 1 Blurry Photo\n                      </span>\n                    ) : (\n                      <span className=\"font-semibold text-emerald-300\">\n                        \342\227\217 4/4 Documents Validated \342\200\224 All KYC Clear\n                      </span>\n                    )}\n                  </div>\n                  <div className=\"flex items-center gap-2\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setActiveStep(3)}\n                      className={`flex-1 h-12 rounded-full text-xs font-bold flex items-center justify-center transition-colors cursor-pointer ${\n                        isPassportBlurry\n                          ? \'bg-slate-400/75 text-[#091329] hover:bg-white\'\n                          : \'bg-white text-[#091329] hover:bg-blue-50\'\n                      }`}\n                    >\n                      {t.continueToPayment}\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => setActiveStep(3)}\n                      className=\"w-12 h-12 rounded-full bg-[#1d63dc] hover:bg-blue-500 text-white flex items-center justify-center shrink-0 transition-colors cursor-pointer\"\n                      aria-label=\"Continue to Payment\"\n                    >\n                      <ArrowUpRight className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </section>\n          )}\n\n          {/* =====================================================================\n              SCREEN 3: STEP 3 \302\267 PAYMENT, N8N WEBHOOK AND WA SYNC\n             ===================================================================== */}\n          {(viewMode === \'board\' || activeStep === 3) && (\n            <section className=\"w-full max-w-[400px] flex flex-col\">\n              <div className=\"text-[11px] font-semibold tracking-wider text-[#8fa9d6] mb-2.5 px-1\">\n                STEP 3 \302\267 PAYMENT, N8N WEBHOOK AND WA SYNC (390\303\2271700)\n              </div>\n\n              <div\n                className=\"relative w-full rounded-[48px] border border-blue-300/25 shadow-[0_24px_80px_rgba(15,45,110,0.55)] overflow-hidden flex flex-col justify-between p-5 text-white\"\n                style={{\n                  background:\n                    \'linear-gradient(180deg, #050b16 0%, #0b1c40 45%, #07132c 100%)\',\n                }}\n              >\n                {/* Top Dynamic Island Notch */}\n                <div className=\"w-24 h-6 bg-[#02050a] rounded-full mx-auto mb-3\" />\n\n                {/* Top App Bar */}\n                <div className=\"flex items-center justify-between mb-4\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveStep(2)}\n                    className=\"w-9 h-9 rounded-full bg-white text-[#091329] flex items-center justify-center cursor-pointer\"\n                    aria-label=\"Back to Step 2\"\n                  >\n                    <ChevronLeft className=\"w-4 h-4\" />\n                  </button>\n                  <span className=\"text-xs font-bold text-white\">\n                    {t.step3Header}\n                  </span>\n                  <button\n                    type=\"button\"\n                    onClick={() => setIsUatConsoleOpen(true)}\n                    className=\"w-9 h-9 rounded-full bg-white text-[#091329] flex items-center justify-center cursor-pointer\"\n                    aria-label=\"Open UAT Console\"\n                  >\n                    <Menu className=\"w-4 h-4\" />\n                  </button>\n                </div>\n\n                {/* 3-Step Segmented Navigation */}\n                <div className=\"grid grid-cols-3 gap-1 p-1 rounded-full bg-[#10234d] border border-blue-400/25 mb-5\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveStep(1)}\n                    className=\"py-2 px-2 rounded-full text-blue-200/75 hover:text-white text-[11px] font-medium truncate cursor-pointer\"\n                  >\n                    1. Unit\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveStep(2)}\n                    className=\"py-2 px-2 rounded-full text-blue-200/75 hover:text-white text-[11px] font-medium truncate cursor-pointer\"\n                  >\n                    2. KYC Valid\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveStep(3)}\n                    className=\"py-2 px-2 rounded-full bg-white text-[#091329] text-[11px] font-bold truncate cursor-pointer\"\n                  >\n                    {t.step3Tab}\n                  </button>\n                </div>\n\n                {/* Booking Summary Card (#ORD-2026-881) */}\n                <div\n                  className=\"rounded-[28px] p-4 mb-5 border border-blue-300/30\"\n                  style={{\n                    background:\n                      \'linear-gradient(180deg, rgba(58,108,192,0.42) 0%, rgba(27,58,122,0.3) 100%)\',\n                  }}\n                >\n                  <div className=\"text-[10px] font-semibold tracking-wider text-blue-200/80 font-mono\">\n                    {t.bookingSummary} \342\200\224 #{activeOrder.orderId}\n                  </div>\n                  <h3 className=\"text-xl font-bold text-white mt-1\">\n                    {selectedCategory.name}\n                  </h3>\n                  <div className=\"text-xs text-blue-100/90 mt-1 space-y-0.5\">\n                    <div>\n                      {formatDisplayDate(startDate)} \342\200\223 {formatDisplayDate(endDate)}{\' \'}\n                      ({rentalDays} {t.daysUnit})\n                    </div>\n                    <div className=\"truncate\">\n                      Delivery: {hotelAndRoom} ({selectedZone.code})\n                    </div>\n                  </div>\n\n                  <div className=\"mt-3 pt-3 border-t border-blue-200/20\">\n                    <div className=\"text-[11px] text-blue-200/80 font-mono tabular-nums\">\n                      Rental ({formatIdr(priceBreakdown.rentalSubtotal)}) + Delivery (\n                      {formatIdr(priceBreakdown.deliveryFee)})\n                    </div>\n                    <div className=\"flex items-center justify-between mt-1\">\n                      <span className=\"text-2xl font-extrabold font-mono tabular-nums text-white\">\n                        {formatIdr(priceBreakdown.totalAmount)}\n                      </span>\n                      <span className=\"px-3 py-1 rounded-full bg-white text-[#091329] text-[11px] font-bold font-mono tabular-nums\">\n                        approx. {priceBreakdown.approxUsd} USD\n                      </span>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Select Payment Method */}\n                <h3 className=\"text-lg font-bold text-white mb-3\">\n                  {t.selectPaymentMethod}\n                </h3>\n\n                <div className=\"space-y-3 mb-5\">\n                  {/* Option 1: Instant Online Payment */}\n                  <div\n                    onClick={() => setPaymentMethod(\'instant_online\')}\n                    className={`rounded-[26px] p-4 border transition-all cursor-pointer ${\n                      paymentMethod === \'instant_online\'\n                        ? \'bg-[#173673]/90 border-blue-400 shadow-lg\'\n                        : \'bg-[#10224a]/80 border-blue-400/20 hover:border-blue-400/40\'\n                    }`}\n                  >\n                    <div className=\"flex items-start gap-3\">\n                      <span\n                        className={`w-5 h-5 rounded-full border-2 flex items-center justify-center mt-0.5 shrink-0 ${\n                          paymentMethod === \'instant_online\'\n                            ? \'border-white bg-blue-500\'\n                            : \'border-blue-300/60\'\n                        }`}\n                      >\n                        {paymentMethod === \'instant_online\' && (\n                          <span className=\"w-2 h-2 rounded-full bg-white\" />\n                        )}\n                      </span>\n                      <div className=\"flex-1\">\n                        <div className=\"text-sm font-bold text-white\">\n                          {t.payOption1Title}\n                        </div>\n                        <div className=\"text-xs text-blue-100/85 mt-0.5\">\n                          {t.payOption1Desc}\n                        </div>\n                        <div className=\"text-[11px] text-blue-300/75 mt-0.5\">\n                          {t.payOption1Sub}\n                        </div>\n                        <div className=\"flex items-center gap-4 mt-2.5 pt-2 border-t border-blue-300/15 text-[11px] font-semibold text-blue-100\">\n                          <span>VISA</span>\n                          <span>QRIS</span>\n                          <span>Mastercard</span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Option 2: Manual Bank Transfer */}\n                  <div\n                    onClick={() => setPaymentMethod(\'manual_transfer\')}\n                    className={`rounded-[26px] p-4 border transition-all cursor-pointer ${\n                      paymentMethod === \'manual_transfer\'\n                        ? \'bg-[#173673]/90 border-blue-400 shadow-lg\'\n                        : \'bg-[#10224a]/80 border-blue-400/20 hover:border-blue-400/40\'\n                    }`}\n                  >\n                    <div className=\"flex items-start gap-3\">\n                      <span\n                        className={`w-5 h-5 rounded-full border-2 flex items-center justify-center mt-0.5 shrink-0 ${\n                          paymentMethod === \'manual_transfer\'\n                            ? \'border-white bg-blue-500\'\n                            : \'border-blue-300/60\'\n                        }`}\n                      >\n                        {paymentMethod === \'manual_transfer\' && (\n                          <span className=\"w-2 h-2 rounded-full bg-white\" />\n                        )}\n                      </span>\n                      <div>\n                        <div className=\"text-sm font-bold text-white\">\n                          {t.payOption2Title}\n                        </div>\n                        <div className=\"text-xs text-blue-100/85 mt-0.5\">\n                          {t.payOption2Desc}\n                        </div>\n                        <div className=\"text-[11px] text-blue-300/75 mt-0.5\">\n                          {t.payOption2Sub}\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Option 3: Cash on Delivery (Pay on Arrival) */}\n                  <div\n                    onClick={() => setPaymentMethod(\'cod_arrival\')}\n                    className={`rounded-[26px] p-4 border transition-all cursor-pointer ${\n                      paymentMethod === \'cod_arrival\'\n                        ? \'bg-[#173673]/90 border-blue-400 shadow-lg\'\n                        : \'bg-[#10224a]/80 border-blue-400/20 hover:border-blue-400/40\'\n                    }`}\n                  >\n                    <div className=\"flex items-start gap-3\">\n                      <span\n                        className={`w-5 h-5 rounded-full border-2 flex items-center justify-center mt-0.5 shrink-0 ${\n                          paymentMethod === \'cod_arrival\'\n                            ? \'border-white bg-blue-500\'\n                            : \'border-blue-300/60\'\n                        }`}\n                      >\n                        {paymentMethod === \'cod_arrival\' && (\n                          <span className=\"w-2 h-2 rounded-full bg-white\" />\n                        )}\n                      </span>\n                      <div>\n                        <div className=\"text-sm font-bold text-white\">\n                          {t.payOption3Title}\n                        </div>\n                        <div className=\"text-[11px] font-semibold text-emerald-300 mt-1\">\n                          \342\227\217 {t.payOption3Badge}\n                        </div>\n                        <div className=\"text-[11px] text-blue-200/80 mt-1\">\n                          {t.payOption3Sub}\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Error Alert if Passport Photo is Blurry on Submit (UAT Scenario #3) */}\n                {bookingFeedbackError && (\n                  <div className=\"rounded-2xl bg-rose-950/90 border border-rose-400/60 p-3.5 mb-4 text-xs text-rose-100 space-y-2\">\n                    <div className=\"flex items-center gap-2 font-bold text-rose-300\">\n                      <AlertTriangle className=\"w-4 h-4 shrink-0\" />\n                      <span>n8n Webhook Response: error_blur</span>\n                    </div>\n                    <p className=\"leading-relaxed\">{bookingFeedbackError}</p>\n                    <button\n                      type=\"button\"\n                      onClick={() => handleSimulatePassportClarity(false)}\n                      className=\"w-full py-2 rounded-xl bg-white text-rose-950 font-bold text-xs cursor-pointer hover:bg-rose-50\"\n                    >\n                      Fix Blurry Passport Photo Now & Re-Verify\n                    </button>\n                  </div>\n                )}\n\n                {/* Primary Submit & Verify CTA */}\n                <div className=\"flex items-center gap-2 mb-5\">\n                  <button\n                    type=\"button\"\n                    onClick={handleSubmitBooking}\n                    disabled={isSubmittingBooking}\n                    className=\"flex-1 h-12 rounded-full bg-white hover:bg-blue-50 text-[#091329] text-xs font-bold flex items-center justify-center gap-2 transition-transform active:scale-[0.99] cursor-pointer shadow-lg\"\n                  >\n                    {isSubmittingBooking && (\n                      <RefreshCw className=\"w-3.5 h-3.5 animate-spin text-blue-600\" />\n                    )}\n                    <span>{t.submitVerifyBooking}</span>\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={handleSubmitBooking}\n                    className=\"w-12 h-12 rounded-full bg-[#1d63dc] hover:bg-blue-500 text-white flex items-center justify-center shrink-0 transition-colors cursor-pointer shadow-lg\"\n                    aria-label=\"Submit Booking\"\n                  >\n                    <ArrowUpRight className=\"w-4 h-4\" />\n                  </button>\n                </div>\n\n                {/* Booking Received & Live Sync Card (#ORD-2026-881) */}\n                <div className=\"rounded-[28px] bg-[#0d1f42]/95 border border-emerald-400/60 p-4 mb-16 shadow-[0_0_30px_rgba(16,185,129,0.15)]\">\n                  <div className=\"flex items-start gap-2.5\">\n                    <Check className=\"w-5 h-5 text-emerald-400 shrink-0 mt-0.5\" />\n                    <div>\n                      <div className=\"text-sm font-bold text-white\">\n                        {t.bookingReceivedTitle} (#{activeOrder.orderId})\n                      </div>\n                      <div className=\"text-[11px] font-semibold text-emerald-300 mt-0.5\">\n                        {activeOrder.status === \'cod_approved_locked\' ||\n                        activeOrder.status === \'paid_locked\'\n                          ? `Status: Approved & Unit Plate Locked (${\n                              activeOrder.assignedPlate || \'DK 4821 FBV\'\n                            })`\n                          : \'Status: Pending Owner COD Approval & Lock\'}\n                      </div>\n                    </div>\n                  </div>\n\n                  <ul className=\"mt-3 space-y-1.5 text-[11px] text-blue-100/90\">\n                    <li>\n                      \342\200\242 Automatic WhatsApp confirmation sent to {countryCode}{\' \'}\n                      {whatsappLocal.slice(0, 3)}...\n                    </li>\n                    <li>\342\200\242 Courier dispatch synced to VIYOND Telegram Bot.</li>\n                    <li>\n                      \342\200\242 E-Receipt and unit plate{\' \'}\n                      {activeOrder.assignedPlate\n                        ? `(${activeOrder.assignedPlate}) `\n                        : \'\'}\n                      locked in Master DB.\n                    </li>\n                  </ul>\n\n                  {/* Quick Telegram Owner Approval Simulator inside Step 3 for UAT #4 */}\n                  {activeOrder.status === \'pending_approval\' && (\n                    <div className=\"mt-3 pt-2.5 border-t border-white/10 flex items-center justify-between gap-2\">\n                      <span className=\"text-[10px] text-blue-200/80\">\n                        UAT #4 (Owner Telegram Bot):\n                      </span>\n                      <button\n                        type=\"button\"\n                        onClick={() =>\n                          handleOwnerTelegramDecision(\n                            activeOrder.orderId,\n                            \'approve\'\n                          )\n                        }\n                        className=\"px-2.5 py-1 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-400/40 text-emerald-200 text-[10px] font-semibold cursor-pointer\"\n                      >\n                        \342\234\223 Approve COD & Lock Plate\n                      </button>\n                    </div>\n                  )}\n\n                  <div className=\"flex items-center gap-2 mt-3.5\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setIsWaModalOpen(true)}\n                      className=\"flex-1 h-11 rounded-full bg-white hover:bg-blue-50 text-[#091329] text-xs font-bold flex items-center justify-center cursor-pointer\"\n                    >\n                      {t.openWhatsappTracking}\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => setIsWaModalOpen(true)}\n                      className=\"w-11 h-11 rounded-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 flex items-center justify-center shrink-0 cursor-pointer\"\n                      aria-label=\"Open WhatsApp Tracking\"\n                    >\n                      <ArrowUpRight className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                </div>\n\n                {/* Floating Direct-to-WA Button (UAT Scenario #5) */}\n                <div className=\"flex justify-end\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setIsWaModalOpen(true)}\n                    className=\"inline-flex items-center gap-2.5 p-1.5 pr-4 rounded-full bg-[#0e2046] hover:bg-[#152c5e] border border-blue-300/35 shadow-xl transition-transform active:scale-95 cursor-pointer\"\n                  >\n                    <span className=\"w-9 h-9 rounded-full bg-white text-emerald-600 font-extrabold text-xs flex items-center justify-center\">\n                      WA\n                    </span>\n                    <div className=\"text-left\">\n                      <div className=\"text-xs font-bold text-white leading-tight\">\n                        {t.askAiCs}\n                      </div>\n                      <div className=\"text-[10px] text-blue-200/80 leading-tight\">\n                        {t.directWhatsapp}\n                      </div>\n                    </div>\n                  </button>\n                </div>\n              </div>\n            </section>\n          )}\n        </div>\n      </main>\n\n      {/* Interactive UAT & Telegram Bot Control Console Drawer */}\n      <UatControlConsole\n        isOpen={isUatConsoleOpen}\n        onClose={() => setIsUatConsoleOpen(false)}\n        siteConfig={siteConfig}\n        onUpdateSiteConfig={setSiteConfig}\n        inventarisMotor={inventarisMotor}\n        orders={orders.length ? orders : [activeOrder]}\n        onToggleCategoryStock={handleToggleCategoryStock}\n        onUpdateSingleUnit={handleUpdateSingleUnit}\n        onOwnerTelegramDecision={handleOwnerTelegramDecision}\n        onTriggerBlurryTest={handleSimulatePassportClarity}\n        idCardIsBlurry={isPassportBlurry}\n      />\n\n      {/* Interactive WhatsApp AI CS & E-Receipt Live Modal (UAT Scenario #4 & #5) */}\n      {isWaModalOpen && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm\">\n          <div className=\"w-full max-w-md rounded-3xl bg-[#0b1829] border border-emerald-500/30 text-white shadow-2xl overflow-hidden flex flex-col max-h-[85vh]\">\n            <div className=\"px-5 py-4 bg-[#075e54] flex items-center justify-between\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-10 h-10 rounded-full bg-white text-[#075e54] font-black text-sm flex items-center justify-center\">\n                  WA\n                </div>\n                <div>\n                  <div className=\"text-sm font-bold text-white\">\n                    {siteConfig.brandName} \342\200\224 Official WhatsApp AI CS\n                  </div>\n                  <div className=\"text-[11px] text-emerald-100 font-mono\">\n                    +{siteConfig.whatsappNumber} \302\267 Evolution API Synced\n                  </div>\n                </div>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => setIsWaModalOpen(false)}\n                className=\"w-8 h-8 rounded-full bg-black/20 hover:bg-black/30 flex items-center justify-center text-white cursor-pointer\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            <div className=\"flex-1 overflow-y-auto p-4 space-y-3 bg-[#09121e]\">\n              {waMessages.map((m, i) => (\n                <div\n                  key={i}\n                  className={`max-w-[85%] rounded-2xl p-3 text-xs leading-relaxed ${\n                    m.sender === \'bot\'\n                      ? \'bg-[#16273d] text-slate-100 rounded-tl-sm\'\n                      : \'bg-[#005c4b] text-white ml-auto rounded-tr-sm\'\n                  }`}\n                >\n                  <div>{m.text}</div>\n                  <div className=\"text-[9px] opacity-60 text-right mt-1 font-mono\">\n                    {m.time}\n                  </div>\n                </div>\n              ))}\n            </div>\n\n            <form\n              onSubmit={handleSendWaChat}\n              className=\"p-3 bg-[#101e30] border-t border-white/10 flex items-center gap-2\"\n            >\n              <input\n                type=\"text\"\n                value={waChatInput}\n                onChange={(e) => setWaChatInput(e.target.value)}\n                placeholder=\"Ask AI CS or check scooter delivery ETA...\"\n                className=\"flex-1 bg-[#09121e] border border-white/15 rounded-full px-4 py-2.5 text-xs text-white focus:outline-none focus:border-emerald-400\"\n              />\n              <button\n                type=\"submit\"\n                className=\"w-10 h-10 rounded-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 flex items-center justify-center shrink-0 cursor-pointer\"\n                aria-label=\"Send WhatsApp Message\"\n              >\n                <Send className=\"w-4 h-4\" />\n              </button>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///components/BookingWizardApp.tsx"
        }
        overwrite: true
      }
    }
