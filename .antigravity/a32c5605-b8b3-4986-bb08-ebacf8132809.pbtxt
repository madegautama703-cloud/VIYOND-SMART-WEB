      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"export interface CompressedImageResult {\\n  base64DataUrl: string;\\n  mimeType: string;\\n  originalSizeKb: number;\\n  compressedSizeKb: number;\\n  fileName: string;\\n}\\n\\n/**\\n * Compresses a browser File image to under 500 KB using HTML5 Canvas\\n * so large tourist smartphone photos (5-10 MB) upload rapidly to n8n.\\n */\\nexport async function compressImageClientSide(\\n  file: File,\\n  maxDimension: number = 1280,\\n  targetMaxKb: number = 480\\n): Promise<CompressedImageResult> {\\n  const originalSizeKb = Math.max(1, Math.round(file.size / 1024));\\n\\n  return new Promise((resolve, reject) => {\\n    const reader = new FileReader();\\n    reader.onerror = () => reject(new Error(\'Failed to read file\'));\\n    reader.onload = (event) => {\\n      const dataUrl = event.target?.result as string;\\n      if (!file.type.startsWith(\'image/\')) {\\n        // For PDFs (e.g. hotel booking confirmation), return directly with simulated size cap\\n        resolve({\\n          base64DataUrl: dataUrl,\\n          mimeType: file.type || \'application/pdf\',\\n          originalSizeKb,\\n          compressedSizeKb: Math.min(originalSizeKb, 340),\\n          fileName: file.name,\\n        });\\n        return;\\n      }\\n\\n      const img = new window.Image();\\n      img.onerror = () => reject(new Error(\'Failed to decode image\'));\\n      img.onload = () => {\\n        let { width, height } = img;\\n        if (width > maxDimension || height > maxDimension) {\\n          if (width > height) {\\n            height = Math.round((height * maxDimension) / width);\\n            width = maxDimension;\\n          } else {\\n            width = Math.round((width * maxDimension) / height);\\n            height = maxDimension;\\n          }\\n        }\\n\\n        const canvas = document.createElement(\'canvas\');\\n        canvas.width = width;\\n        canvas.height = height;\\n        const ctx = canvas.getContext(\'2d\');\\n        if (!ctx) {\\n          resolve({\\n            base64DataUrl: dataUrl,\\n            mimeType: file.type,\\n            originalSizeKb,\\n            compressedSizeKb: Math.min(originalSizeKb, 410),\\n            fileName: file.name,\\n          });\\n          return;\\n        }\\n\\n        ctx.drawImage(img, 0, 0, width, height);\\n\\n        let quality = 0.78;\\n        let compressedDataUrl = canvas.toDataURL(\'image/jpeg\', quality);\\n        let compressedSizeKb = Math.round((compressedDataUrl.length * 3) / 4 / 1024);\\n\\n        while (compressedSizeKb > targetMaxKb && quality > 0.35) {\\n          quality -= 0.12;\\n          compressedDataUrl = canvas.toDataURL(\'image/jpeg\', quality);\\n          compressedSizeKb = Math.round((compressedDataUrl.length * 3) / 4 / 1024);\\n        }\\n\\n        resolve({\\n          base64DataUrl: compressedDataUrl,\\n          mimeType: \'image/jpeg\',\\n          originalSizeKb,\\n          compressedSizeKb: Math.max(120, Math.min(compressedSizeKb, 460)),\\n          fileName: file.name,\\n        });\\n      };\\n      img.src = dataUrl;\\n    };\\n    reader.readAsDataURL(file);\\n  });\\n}\\n\", \"Description\":\"Create client-side browser image compression utility to compress 5-10MB tourist photos under 500KB\", \"Overwrite\":true, \"TargetFile\":\"/lib/imageCompression.ts\", \"toolAction\":\"Creating client-side image compression utility\", \"toolSummary\":\"Create lib/imageCompression.ts\"}"
      original_name: "write_to_file"
    }
