  code_action {
    action_spec {
      create_file {
        instruction: "import type { Metadata } from \'next\';\nimport { Plus_Jakarta_Sans, JetBrains_Mono } from \'next/font/google\';\nimport \'./globals.css\';\n\nconst plusJakarta = Plus_Jakarta_Sans({\n  subsets: [\'latin\'],\n  weight: [\'400\', \'500\', \'600\', \'700\', \'800\'],\n  variable: \'--font-sans\',\n});\n\nconst jetbrainsMono = JetBrains_Mono({\n  subsets: [\'latin\'],\n  weight: [\'400\', \'500\', \'600\', \'700\'],\n  variable: \'--font-mono\',\n});\n\nexport const metadata: Metadata = {\n  title: \'VIYOND \342\200\224 Smart Web Scooter Booking Engine (Bali)\',\n  description:\n    \'Rent a scooter in Bali with instant online KYC verification, live fleet inventory sync, automatic zone delivery calculator, and free hotel delivery.\',\n  openGraph: {\n    title: \'VIYOND \342\200\224 Smart Web Scooter Booking Engine (Bali)\',\n    description:\n      \'Rent a scooter in Bali with instant online KYC verification, live fleet inventory sync, automatic zone delivery calculator, and free hotel delivery.\',\n    type: \'website\',\n  },\n  twitter: {\n    card: \'summary_large_image\',\n    title: \'VIYOND \342\200\224 Smart Web Scooter Booking Engine (Bali)\',\n    description:\n      \'Rent a scooter in Bali with instant online KYC verification, live fleet inventory sync, automatic zone delivery calculator, and free hotel delivery.\',\n  },\n};\n\nexport default function RootLayout({ children }: { children: React.ReactNode }) {\n  return (\n    <html lang=\"en\" className={`${plusJakarta.variable} ${jetbrainsMono.variable}`}>\n      <body\n        suppressHydrationWarning\n        className=\"bg-[#030711] text-slate-100 font-sans antialiased selection:bg-blue-500 selection:text-white\"\n      >\n        {children}\n      </body>\n    </html>\n  );\n}\n"
        path {
          absolute_uri: "file:///app/layout.tsx"
        }
        overwrite: true
      }
    }
